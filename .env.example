APP_NAME="Fin-Track"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:12000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Identifiants de base : NE JAMAIS committer de vrais identifiants dans ce
# fichier. En production, définir DB_* dans les variables d'environnement
# sécurisées de la plateforme (Render) ou dans un .env local non suivi par Git.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestdepense
DB_USERNAME=gestdepense
DB_PASSWORD=
# Alternative Render (prioritaire si définie, cf. config/database.php) :
# DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# À activer en production (et le domaine doit être en HTTPS) :
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@fin-track.app"
MAIL_FROM_NAME="${APP_NAME}"

# Production: your frontend URL
FRONTEND_URL=http://localhost:12005

# Production: your domain (without https://)
SANCTUM_STATEFUL_DOMAINS=localhost:12000,localhost:12005

# Durée de vie des jetons d'API Sanctum (A-11)
SANCTUM_TOKEN_EXPIRATION_MINUTES=1440
# Nombre maximum de jetons conservés par utilisateur
AUTH_MAX_SESSIONS=10
# Durée du jeton quand « se souvenir de moi » est coché
AUTH_REMEMBER_LIFETIME_MINUTES=43200

# Google OAuth credentials (set in Render dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
